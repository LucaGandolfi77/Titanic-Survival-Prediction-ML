# ╔══════════════════════════════════════════════════════════╗
# ║  Copy this file to .env and fill in your values         ║
# ║  cp .env.example .env                                   ║
# ╚══════════════════════════════════════════════════════════╝

# ── OpenRouter API Key (optional) ────────────────────────────
# Used for LLM text-cleaning before TTS.
# Without it, the pipeline still works (raw text → audio).
# Get one for free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM model for text cleaning ─────────────────────────────
# MODEL_CLEANER=google/gemma-4-31b-it:free

# ── TTS Voice ───────────────────────────────────────────────
# Run `python main.py --list-voices` to see all options.
# English:  en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
# Italian:  it-IT-ElsaNeural, it-IT-DiegoNeural
# TTS_VOICE=en-US-AriaNeural

# ── TTS Speed & Volume ──────────────────────────────────────
# TTS_RATE=+0%
# TTS_VOLUME=+0%

# ── Rate limiting ────────────────────────────────────────────
# RATE_LIMIT_PAUSE=5.0
# MAX_RETRIES=4

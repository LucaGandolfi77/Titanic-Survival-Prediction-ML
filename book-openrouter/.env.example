# ╔══════════════════════════════════════════════════════════╗
# ║  Copy this file to .env and fill in your values         ║
# ║  cp .env.example .env                                   ║
# ╚══════════════════════════════════════════════════════════╝

# ── OpenRouter API Key ───────────────────────────────────────
# Get yours (free) at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: app name shown in OpenRouter dashboard
OPENROUTER_APP_NAME=BookAgents

# ── Free model assignments ───────────────────────────────────
# You can swap any of these with other ":free" models listed at
# https://openrouter.ai/models?q=free
MODEL_WRITER=nvidia/nemotron-3-super-120b-a12b:free
MODEL_EDITOR=google/gemma-4-31b-it:free
MODEL_SUMMARIZER=openai/gpt-oss-120b:free
MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b:free
MODEL_TRANSLATOR=google/gemma-4-31b-it:free

# ── Generation parameters ────────────────────────────────────
TEMPERATURE_CREATIVE=0.85
TEMPERATURE_ANALYTICAL=0.3
MAX_TOKENS=4096

# ── Rate limiting ────────────────────────────────────────────
# Pause in seconds between API calls (free tier is limited)
RATE_LIMIT_PAUSE=2.0
MAX_RETRIES=3

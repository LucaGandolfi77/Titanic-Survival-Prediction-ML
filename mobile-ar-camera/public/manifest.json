{
  "name": "AR Snap Camera",
  "short_name": "AR Snap",
  "description": "Snapchat-style AR camera with WebGL shaders and MediaPipe tracking",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#090b12",
  "theme_color": "#090b12",
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["camera", "photography", "entertainment"],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "AR Snap Photo",
      "text": "Check out my AR photo!",
      "url": "https://snap.ar.app/",
      "files": [
        {
          "name": "media",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Take Photo",
      "short_name": "Photo",
      "description": "Open camera and take a photo",
      "url": "/?shortcut=photo",
      "icons": [{ "src": "/icons/shortcut-photo.png", "sizes": "96x96" }]
    }
  ]
}

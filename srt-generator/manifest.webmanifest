{
  "name": "SRT Generator Suite",
  "short_name": "SRT Gen",
  "description": "Suite PWA per generazione e modifica sottotitoli SRT, trascrizione audio, editing video. Tutto nel browser, 100% locale.",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#0f1117",
  "theme_color": "#0f1117",
  "orientation": "any",
  "icons": [
    {
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'%3E%3Crect width='192' height='192' rx='40' fill='%236c8ef5'/%3E%3Ctext x='96' y='130' font-size='90' text-anchor='middle' fill='white'%3ET%3C/text%3E%3C/svg%3E",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='120' fill='%236c8ef5'/%3E%3Ctext x='256' y='340' font-size='280' text-anchor='middle' fill='white'%3ET%3C/text%3E%3C/svg%3E",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "file",
      "files": [
        {
          "name": "file",
          "accept": [
            "audio/*",
            "video/*",
            ".srt"
          ]
        }
      ]
    }
  },
  "categories": ["utilities", "multimedia", "productivity"],
  "lang": "it"
}
